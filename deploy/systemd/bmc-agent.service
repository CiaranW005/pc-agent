[Unit]
Description=BMC PC Agent
# Attempt an update before starting the agent.
# Wants allows the installed agent to start even if the updater fails.
Wants=network-online.target bmc-agent-update.service
After=network-online.target bmc-agent-update.service

[Service]
Type=simple
User=bmc-agent
Group=bmc-agent

ExecStart=/usr/local/bin/bmc-agent

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target